# Copy to .env for local development. Never commit .env or real values.
# Speech engine: mock | ios | unavailable. Release builds ignore "mock" and fall back to "unavailable".
# eas.json pins this to "unavailable" for the preview and production profiles.
EXPO_PUBLIC_SPEECH_IMPL=mock
# Blocking demo (docs/architecture.md section 7.1): 1 shows Blocked apps on the Unlock tab and simulates Screen Time.
# Development builds always have it. eas.json sets it for the development and preview profiles, never production.
EXPO_PUBLIC_BLOCKING_DEMO=1
