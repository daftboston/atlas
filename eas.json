{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_BLOCKING_DEMO": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SPEECH_IMPL": "unavailable",
        "EXPO_PUBLIC_BLOCKING_DEMO": "1"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_SPEECH_IMPL": "unavailable"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
